# AI Provider (Required) - Get free key at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# Redis URL (Optional) - Cloud Redis (Upstash) or local instance. If omitted, falls back to memory cache.
REDIS_URL="rediss://default:password@your-redis-host.upstash.io:6379"

# Frontend Base URL (Optional - defaults to relative /api on same domain)
# NEXT_PUBLIC_API_URL=

